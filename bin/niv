DATA_PATH = os.path.expanduser("~/.local/share/bible/niv_clean.json")

if not os.path.exists(DATA_PATH):
    print("Error: NIV database missing. Run database setup first.")
    sys.exit(1)

with open(DATA_PATH, "r", encoding="utf-8") as f:
    bible = json.load(f)

